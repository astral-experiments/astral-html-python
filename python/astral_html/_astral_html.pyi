from collections.abc import Iterable
from typing import Never, final, overload

def parse(html: str, *, tags: Iterable[str] | None = None) -> Document: ...

@final
class Document:
    def __new__(cls, _cannot_construct_directly: Never, /) -> Never: ...
    def elements(self, tag: str | None = None) -> list[Element]: ...
    def select(self, css: str) -> list[Element]: ...
    def select_one(self, css: str) -> Element | None: ...

@final
class Element:
    def __new__(cls, _cannot_construct_directly: Never, /) -> Never: ...
    @property
    def tag(self) -> str: ...
    @property
    def attrs(self) -> dict[str, str]: ...
    @property
    def text(self) -> str: ...
    @property
    def parent(self) -> Element | None: ...
    @property
    def children(self) -> list[Element]: ...
    @overload
    def get(self, name: str) -> str | None: ...
    @overload
    def get[T](self, name: str, default: T) -> str | T: ...
    def elements(self, tag: str | None = None) -> list[Element]: ...
    def select(self, css: str) -> list[Element]: ...
    def select_one(self, css: str) -> Element | None: ...
