from collections.abc import Iterable, Iterator, Mapping
from typing import Never, final, overload

class InvalidSelectorError(ValueError): ...
class ResourceLimitError(ValueError): ...

def parse(
    html: str, *, retain_subtrees: str | Iterable[str] | None = None
) -> Document: ...

@final
class Document:
    def __new__(cls, _cannot_construct_directly: Never, /) -> Never: ...
    def select(self, css: str) -> list[Element]: ...
    def select_one(self, css: str) -> Element | None: ...

@final
class Element:
    def __new__(cls, _cannot_construct_directly: Never, /) -> Never: ...
    @property
    def tag(self) -> str: ...
    @property
    def attrs(self) -> Mapping[str, str]: ...
    @property
    def text(self) -> str: ...
    def iter_text(self) -> Iterator[str]: ...
    def iter_content(self) -> Iterator[str | Element]: ...
    @property
    def parent(self) -> Element | None: ...
    @property
    def children(self) -> list[Element]: ...
    def __getitem__(self, name: str, /) -> str: ...
    @overload
    def get(self, name: str) -> str | None: ...
    @overload
    def get[T](self, name: str, default: T) -> str | T: ...
    def select(self, css: str) -> list[Element]: ...
    def select_one(self, css: str) -> Element | None: ...
